{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbrain_inertial = Inertial()\nleft_motor_a = Motor(Ports.PORT1, 2.5, False)\nleft_motor_b = Motor(Ports.PORT2, 2.5, False)\nleft_drive_smart = MotorGroup(left_motor_a, left_motor_b)\n\nright_motor_a = Motor(Ports.PORT7, 2.5, True)\nright_motor_b = Motor(Ports.PORT8, 2.5, True)\nright_drive_smart = MotorGroup(right_motor_a, right_motor_b)\ndrivetrain = DriveTrain(left_drive_smart, right_drive_smart, 200, 173, 76, MM, 1)\ncatapult_sensor = Bumper(Ports.PORT5)\nleft_diff = Motor(Ports.PORT4, False)\nright_diff = Motor(Ports.PORT10, False)\nclaw_thing = Pneumatic(Ports.PORT3)\ncontroller = Controller()\n\n\n\n# generating and setting random seed\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    xaxis = brain_inertial.acceleration(XAXIS) * 1000\n    yaxis = brain_inertial.acceleration(YAXIS) * 1000\n    zaxis = brain_inertial.acceleration(ZAXIS) * 1000\n    systemTime = brain.timer.system() * 100\n    urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) \n    \n# Initialize random seed \ninitializeRandomSeed()\n\n#endregion VEXcode Generated Robot Configuration\n\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n# \tAuthor:       VEX\n# \tCreated:\n# \tDescription:  VEXcode IQ Python Project\n# \n# ------------------------------------------\ndef left_and_right(t):\n    if t == 1:\n        right_drive_smart.set_velocity(80, PERCENT)\n    else:\n        right_drive_smart.set_velocity(100, PERCENT)\ndef intake():\n    claw_thing.extend(CYLINDER2)\n    claw = True\n    right_diff.set_timeout(2, SECONDS)\n    left_diff.set_timeout(2, SECONDS)\n    right_diff.spin_for(FORWARD, 235, DEGREES, wait=False)\n    left_diff.spin_for(REVERSE, 235, DEGREES)\n    claw_thing.retract(CYLINDER2)\n    wait(0.5, SECONDS)\n    right_diff.set_timeout(0, SECONDS)\n    left_diff.set_timeout(0, SECONDS)\n    claw = False\n    left_diff.set_velocity(50, PERCENT)\n    right_diff.set_velocity(50, PERCENT)\n    right_diff.spin_for(REVERSE, 235, DEGREES, wait=False)\n    left_diff.spin_for(FORWARD, 235, DEGREES)\n    left_diff.set_velocity(100, PERCENT)\n    right_diff.set_velocity(100, PERCENT)\ndef Launch_load():\n    global myVariable, claw, console_thingy, screen_precision, console_precision\n    wait(1, SECONDS)\n    left_diff.spin_for(FORWARD, 50, DEGREES, wait=False)\n    right_diff.spin_for(FORWARD, 50, DEGREES)\n    wait(0.2, SECONDS)\n    Wind_up()\ndef Wind_up():\n    global myVariable, claw, console_thingy, screen_precision, console_precision\n    left_diff.spin(REVERSE)\n    right_diff.spin(REVERSE)\n    while not catapult_sensor.pressing():\n        wait(20, MSEC)\n    left_diff.stop()\n    right_diff.stop()\n# Library imports\nfrom vex import *\nleft_and_right(1)\nclaw_thing.retract(CYLINDER2)\nWind_up()\ndrivetrain.set_turn_velocity(100, PERCENT)\ndrivetrain.set_drive_velocity(100, PERCENT)\n# Begin project code\nwait(1,SECONDS)\ndrivetrain.turn_for(RIGHT, 100, DEGREES)\ndrivetrain.set_timeout(3, SECONDS)\ndrivetrain.drive_for(REVERSE, 400, MM)\nLaunch_load()\ndrivetrain.drive_for(FORWARD, 600, MM)\nintake()\ndrivetrain.set_timeout(3, SECONDS)\ndrivetrain.drive_for(REVERSE, 800, MM)\nLaunch_load()\ndrivetrain.set_timeout(3, SECONDS)\ndrivetrain.drive_for(FORWARD, 1000, MM)\nintake()\ndrivetrain.set_timeout(3, SECONDS)\ndrivetrain.drive_for(REVERSE, 1200, MM)\nLaunch_load()\nfor _ in range(2):\n    drivetrain.set_timeout(2.5, SECONDS)\n    drivetrain.drive_for(FORWARD, 1500, MM)\n    drivetrain.drive_for(REVERSE, 75, MM)\n    intake()\n    drivetrain.set_timeout(5, SECONDS)\n    drivetrain.drive_for(REVERSE, 1600, MM)\n    Launch_load()\n","textLanguage":"python","robotConfig":[{"port":[1,2,7,8,0],"name":"drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"4-motor","wheelSize":"200mm","gearRatio":"5:2","direction":"fwd","gyroType":"none","width":"173","unit":"mm","wheelbase":"76","wheelbaseUnit":"mm","xOffset":"0","yOffset":"0","thetaOffset":"0"},"triportSourcePort":22},{"port":[5],"name":"catapult_sensor","customName":true,"deviceType":"Bumper","deviceClass":"bumper","setting":{},"triportSourcePort":22},{"port":[4],"name":"left_diff","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[10],"name":"right_diff","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[3],"name":"claw_thing","customName":true,"deviceType":"Pneumatic","deviceClass":"pneumatic","setting":{"cylinder1":"cylinder1","cylinder2":"cylinder2","cylinder1_reversed":"false","cylinder2_reversed":"false","cylinder3":"","cylinder4":""},"triportSourcePort":22},{"port":[],"name":"controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","e":"","eDir":"false","f":"","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"none"},"triportSourcePort":22}],"slot":6,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}