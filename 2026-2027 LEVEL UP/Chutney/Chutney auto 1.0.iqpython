{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbrain_inertial = Inertial()\nleft_motor_a = Motor(Ports.PORT1, 2.5, False)\nleft_motor_b = Motor(Ports.PORT3, 2.5, False)\nleft_drive_smart = MotorGroup(left_motor_a, left_motor_b)\n\nright_motor_a = Motor(Ports.PORT7, 2.5, True)\nright_motor_b = Motor(Ports.PORT9, 2.5, True)\nright_drive_smart = MotorGroup(right_motor_a, right_motor_b)\ndrivetrain = DriveTrain(left_drive_smart, right_drive_smart, 200, 173, 76, MM, 1)\ncatapult_sensor = Bumper(Ports.PORT2)\nleft_diff = Motor(Ports.PORT4, False)\nright_diff = Motor(Ports.PORT10, False)\nclaw_thing = Pneumatic(Ports.PORT12)\ncontroller = Controller()\ntouchled_8 = Touchled(Ports.PORT8)\n\n\n\n# generating and setting random seed\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    xaxis = brain_inertial.acceleration(XAXIS) * 1000\n    yaxis = brain_inertial.acceleration(YAXIS) * 1000\n    zaxis = brain_inertial.acceleration(ZAXIS) * 1000\n    systemTime = brain.timer.system() * 100\n    urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) \n    \n# Initialize random seed \ninitializeRandomSeed()\n\n#endregion VEXcode Generated Robot Configuration\n\n# ------------------------------------------\n# \n# \tProject:      VEXcode Project\n# \tAuthor:       VEX\n# \tCreated:\n# \tDescription:  VEXcode IQ Python Project\n# \n# ------------------------------------------\ndrivetrain.set_stopping(HOLD)\ndef l4():\n    wait(0.5, SECONDS)\n    claw_thing.extend(CYLINDER2)\n    left_diff.spin_for(FORWARD, 50, DEGREES, wait=False)\n    right_diff.spin_for(FORWARD, 50, DEGREES)\n    wait(0.2, SECONDS)\n    Wind_up()\n\n\ndef intake():\n    claw_thing.retract(CYLINDER1)\n    claw = True\n    right_diff.set_timeout(2, SECONDS)\n    left_diff.set_timeout(2, SECONDS)\n    right_diff.spin_for(FORWARD, 235, DEGREES, wait=False)\n    left_diff.spin_for(REVERSE, 235, DEGREES)\n    claw_thing.extend(CYLINDER1)\n    wait(0.5, SECONDS)\n    right_diff.set_timeout(0, SECONDS)\n    left_diff.set_timeout(0, SECONDS)\n    claw = False\n    left_diff.set_velocity(50, PERCENT)\n    right_diff.set_velocity(50, PERCENT)\n    right_diff.spin_for(REVERSE, 235, DEGREES, wait=False)\n    left_diff.spin_for(FORWARD, 235, DEGREES)\n    left_diff.set_velocity(100, PERCENT)\n    right_diff.set_velocity(100, PERCENT)\n    drivetrain.turn_for(RIGHT, 30, DEGREES)\ndef Launch_load():\n    global myVariable, claw, console_thingy, screen_precision, console_precision\n    claw_thing.retract(CYLINDER2)\n    wait(1, SECONDS)\n    left_diff.spin_for(FORWARD, 50, DEGREES, wait=False)\n    right_diff.spin_for(FORWARD, 50, DEGREES)\n    wait(0.2, SECONDS)\n    Wind_up()\ndef Wind_up():\n    global myVariable, claw, console_thingy, screen_precision, console_precision\n    left_diff.spin(REVERSE)\n    right_diff.spin(REVERSE)\n    while not catapult_sensor.pressing():\n        wait(20, MSEC)\n    left_diff.stop()\n    right_diff.stop()\n# Library imports\nWind_up()\nclaw_thing.retract(CYLINDER2)\nfrom vex import *\ndef main():\n    while not touchled_8.pressing():\n        wait(20, MSEC)\n    claw_thing.extend(CYLINDER2)\n    drivetrain.set_drive_velocity(100, PERCENT)\n    drivetrain.set_turn_velocity(50, PERCENT)\n    drivetrain.drive_for(REVERSE, 90, MM)\n    drivetrain.turn_for(LEFT, 30, DEGREES)\n    drivetrain.set_timeout(0.75, SECONDS)\n    drivetrain.drive_for(REVERSE, 400, MM)\n    wait(0.5, SECONDS)\n    l4()\n    drivetrain.drive_for(FORWARD, 40, MM)\n    drivetrain.turn_for(RIGHT, 32.5, DEGREES)\n    drivetrain.set_timeout(0.7, SECONDS)\n    drivetrain.drive_for(FORWARD, 300, MM)\n    claw_thing.retract(CYLINDER2)\n    Wind_up()\n    drivetrain.set_turn_velocity(100, PERCENT)\n    drivetrain.set_drive_velocity(100, PERCENT)\n    # Begin project code\n    wait(1,SECONDS)\n    drivetrain.turn_for(RIGHT, 130, DEGREES)\n    drivetrain.set_timeout(3, SECONDS)\n    drivetrain.drive_for(REVERSE, 1000, MM)\n    drivetrain.set_timeout(0, SECONDS)\n    drivetrain.drive_for(REVERSE, 10, MM)\n    drivetrain.drive_for(FORWARD, 600, MM)\n    intake()\n    drivetrain.set_timeout(3, SECONDS)\n    drivetrain.drive_for(REVERSE, 800, MM)\n    Launch_load()\n    drivetrain.set_timeout(3, SECONDS)\n    drivetrain.drive_for(FORWARD, 1000, MM)\n    intake()\n    drivetrain.set_timeout(3, SECONDS)\n    drivetrain.drive_for(REVERSE, 1200, MM)\n    Launch_load()\n    for _ in range(4):\n        drivetrain.set_timeout(2.5, SECONDS)\n        drivetrain.drive_for(FORWARD, 1500, MM)\n        claw_thing.extend(CYLINDER1)\n        drivetrain.drive_for(REVERSE, 75, MM)\n        intake()\n        drivetrain.set_timeout(5, SECONDS)\n        drivetrain.drive_for(REVERSE, 1600, MM)\n        Launch_load()\nmain()","textLanguage":"python","robotConfig":[{"port":[1,3,7,9,0],"name":"drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"4-motor","wheelSize":"200mm","gearRatio":"5:2","direction":"fwd","gyroType":"none","width":"173","unit":"mm","wheelbase":"76","wheelbaseUnit":"mm","xOffset":"0","yOffset":"0","thetaOffset":"0"},"triportSourcePort":22},{"port":[2],"name":"catapult_sensor","customName":true,"deviceType":"Bumper","deviceClass":"bumper","setting":{},"triportSourcePort":22},{"port":[4],"name":"left_diff","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[10],"name":"right_diff","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[12],"name":"claw_thing","customName":true,"deviceType":"Pneumatic","deviceClass":"pneumatic","setting":{"cylinder1":"cylinder1","cylinder2":"cylinder2","cylinder1_reversed":"false","cylinder2_reversed":"false","cylinder3":"","cylinder4":""},"triportSourcePort":22},{"port":[],"name":"controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","e":"","eDir":"false","f":"","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"none"},"triportSourcePort":22},{"port":[8],"name":"touchled_8","customName":false,"deviceType":"TouchLED","deviceClass":"touchled","setting":{},"triportSourcePort":22}],"slot":4,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}