{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbrain_inertial = Inertial()\nLeftDiff = Motor(Ports.PORT4, False)\nRightDiff = Motor(Ports.PORT10, False)\ncontroller = Controller()\nPneumatic3 = Pneumatic(Ports.PORT12)\nleft_motor_a = Motor(Ports.PORT1, 1.0, False)\nleft_motor_b = Motor(Ports.PORT3, 1.0, False)\nleft_drive_smart = MotorGroup(left_motor_a, left_motor_b)\n\nright_motor_a = Motor(Ports.PORT7, 1.0, True)\nright_motor_b = Motor(Ports.PORT9, 1.0, True)\nright_drive_smart = MotorGroup(right_motor_a, right_motor_b)\ndrivetrain = DriveTrain(left_drive_smart, right_drive_smart, 200, 173, 76, MM, 1)\nbumper_2 = Bumper(Ports.PORT2)\ntouchled_8 = Touchled(Ports.PORT8)\n\n\n\n# generating and setting random seed\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    xaxis = brain_inertial.acceleration(XAXIS) * 1000\n    yaxis = brain_inertial.acceleration(YAXIS) * 1000\n    zaxis = brain_inertial.acceleration(ZAXIS) * 1000\n    systemTime = brain.timer.system() * 100\n    urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) \n    \n# Initialize random seed \ninitializeRandomSeed()\n\n#endregion VEXcode Generated Robot Configuration\n\nscreen_precision = 0\nconsole_precision = 0\nmyVariable = 0\nmy_event = Event()\nclaw = False\nconsole_thingy = False\nFl4 = False\nl3l4 = False\n\ndef Wind_up():\n    global myVariable, my_event, claw, console_thingy, Fl4, l3l4, screen_precision, console_precision\n    LeftDiff.spin(REVERSE)\n    RightDiff.spin(REVERSE)\n    while not bumper_2.pressing():\n        wait(20, MSEC)\n    LeftDiff.stop()\n    RightDiff.stop()\n\ndef shoot():\n    global myVariable, my_event, claw, console_thingy, Fl4, l3l4, screen_precision, console_precision\n    LeftDiff.set_velocity(100, PERCENT)\n    RightDiff.set_velocity(100, PERCENT)\n    LeftDiff.spin_for(FORWARD, 50, DEGREES, wait=False)\n    RightDiff.spin_for(FORWARD, 50, DEGREES)\n    wait(0.2, SECONDS)\n    Wind_up()\n\ndef controllerbuttonLUp_pressed_callback_0():\n    global myVariable, my_event, claw, console_thingy, Fl4, l3l4, screen_precision, console_precision\n    Wind_up()\n\ndef controllerbuttonRDown_pressed_callback_0():\n    global myVariable, my_event, claw, console_thingy, Fl4, l3l4, screen_precision, console_precision\n    shoot()\n\ndef controllerbuttonRUp_pressed_callback_0():\n    global myVariable, my_event, claw, console_thingy, Fl4, l3l4, screen_precision, console_precision\n    if l3l4:\n        touchled_8.set_color(Color.RED)\n        Pneumatic3.retract(CYLINDER2)\n        l3l4 = False\n    else:\n        touchled_8.set_color(Color.BLUE)\n        Pneumatic3.extend(CYLINDER2)\n        l3l4 = True\n\ndef when_started1():\n    global myVariable, my_event, claw, console_thingy, Fl4, l3l4, screen_precision, console_precision\n    claw = True\n    console_precision = 6\n    drivetrain.set_stopping(COAST)\n    left_drive_smart.set_max_torque(100,PERCENT)\n\n    right_drive_smart.set_max_torque(100,PERCENT)\ndef dol4forsomereason():\n    global Fl4\n    touchled_8.set_color(Color.BLUE)\n    Pneumatic3.extend(CYLINDER2)\n    l3l4 = True\n    drivetrain.set_drive_velocity(100, PERCENT)\n    drivetrain.set_turn_velocity(50, PERCENT)\n    drivetrain.drive_for(REVERSE, 90, MM)\n    drivetrain.turn_for(LEFT, 19, DEGREES)\n    drivetrain.set_timeout(0.6, SECONDS)\n    drivetrain.drive_for(REVERSE, 100, MM)\n    wait(0.1, SECONDS)\n    my_event.broadcast()\n    Fl4 = True\n\ndef when_started2():\n    global myVariable, my_event, claw, console_thingy, Fl4, l3l4, screen_precision, console_precision\n    print(\"\\033[2J\")\n    Fl4 = False\n    l3l4 = True\n    LeftDiff.set_max_torque(100, PERCENT)\n    RightDiff.set_max_torque(100, PERCENT)\n    LeftDiff.set_velocity(100, PERCENT)\n    RightDiff.set_velocity(100, PERCENT)\n    Wind_up()\n\ndef controllerbuttonEUp_pressed_callback_0():\n    global myVariable, my_event, claw, console_thingy, Fl4, l3l4, screen_precision, console_precision\n    brain.program_stop()\n\ndef controllerbuttonFDown_pressed_callback_0():\n    global myVariable, my_event, claw, console_thingy, Fl4, l3l4, screen_precision, console_precision\n    Pneumatic3.retract(CYLINDER1)\n    claw = True\n    LeftDiff.set_timeout(2, SECONDS)\n    RightDiff.set_timeout(2, SECONDS)\n    RightDiff.spin_for(FORWARD, 235, DEGREES, wait=False)\n    LeftDiff.spin_for(REVERSE, 235, DEGREES)\n    Pneumatic3.extend(CYLINDER1)\n    wait(0.05, SECONDS)\n    claw = False\n    LeftDiff.set_timeout(0, SECONDS)\n    RightDiff.set_timeout(0, SECONDS)\n    LeftDiff.set_velocity(50, PERCENT)\n    RightDiff.set_velocity(50, PERCENT)\n    RightDiff.spin_for(REVERSE, 235, DEGREES, wait=False)\n    LeftDiff.spin_for(FORWARD, 235, DEGREES)\n    LeftDiff.set_velocity(100, PERCENT)\n    RightDiff.set_velocity(100, PERCENT)\n\ndef controllerbuttonFUp_pressed_callback_0():\n    global myVariable, my_event, claw, console_thingy, Fl4, l3l4, screen_precision, console_precision\n    if claw:\n        Pneumatic3.extend(CYLINDER1)\n        claw = False\n    else:\n        Pneumatic3.retract(CYLINDER1)\n        claw = True\n\ndef controllerbuttonLUp_pressed_callback_1():\n    global myVariable, my_event, claw, console_thingy, Fl4, l3l4, screen_precision, console_precision\n    Fl4 = True\n\ndef when_started3():\n    global myVariable, my_event, claw, console_thingy, Fl4, l3l4, screen_precision, console_precision\n    while True:\n        if Fl4:\n            drivetrain.drive(FORWARD)\n            left_drive_smart.set_velocity((controller.axisA.position()*0.9 + controller.axisC.position() * 0.27), PERCENT)\n\n            right_drive_smart.set_velocity((controller.axisA.position()*0.9 - controller.axisC.position() * 0.27), PERCENT)\n        wait(20, MSEC)\n\ndef controllerbuttonEDown_pressed_callback_0():\n    global myVariable, my_event, claw, console_thingy, Fl4, l3l4, screen_precision, console_precision\n    if not Fl4:\n        dol4forsomereason()\n\ndef my_event_callback_0():\n    global myVariable, my_event, claw, console_thingy, Fl4, l3l4, screen_precision, console_precision\n    shoot()\n\n# system event handlers\ncontroller.buttonLUp.pressed(controllerbuttonLUp_pressed_callback_0)\ncontroller.buttonLUp.pressed(controllerbuttonLUp_pressed_callback_1)\ncontroller.buttonRDown.pressed(controllerbuttonRDown_pressed_callback_0)\ncontroller.buttonRUp.pressed(controllerbuttonRUp_pressed_callback_0)\ncontroller.buttonEUp.pressed(controllerbuttonEUp_pressed_callback_0)\ncontroller.buttonFDown.pressed(controllerbuttonFDown_pressed_callback_0)\ncontroller.buttonFUp.pressed(controllerbuttonFUp_pressed_callback_0)\ncontroller.buttonEDown.pressed(controllerbuttonEDown_pressed_callback_0)\nmy_event(my_event_callback_0)\n# add 15ms delay to make sure events are registered correctly.\nwait(15, MSEC)\n\nws2 = Thread( when_started2 )\nws3 = Thread( when_started3 )\nwhen_started1()\n","textLanguage":"python","robotConfig":[{"port":[4],"name":"LeftDiff","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[10],"name":"RightDiff","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[],"name":"controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","e":"","eDir":"false","f":"","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"none"},"triportSourcePort":22},{"port":[12],"name":"Pneumatic3","customName":true,"deviceType":"Pneumatic","deviceClass":"pneumatic","setting":{"cylinder1":"claw","cylinder2":"l3l4","cylinder1_reversed":"true","cylinder2_reversed":"false"},"triportSourcePort":22},{"port":[1,3,7,9,0],"name":"drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"4-motor","wheelSize":"200mm","gearRatio":"1:1","direction":"fwd","gyroType":"none","width":"173","unit":"mm","wheelbase":"76","wheelbaseUnit":"mm","xOffset":"0","yOffset":"0","thetaOffset":"0"},"triportSourcePort":22},{"port":[2],"name":"bumper_2","customName":false,"deviceType":"Bumper","deviceClass":"bumper","setting":{},"triportSourcePort":22},{"port":[8],"name":"touchled_8","customName":false,"deviceType":"TouchLED","deviceClass":"touchled","setting":{},"triportSourcePort":22}],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}