{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbrain_inertial = Inertial()\nleft_motor_a = Motor(Ports.PORT1, 1.0, False)\nleft_motor_b = Motor(Ports.PORT3, 1.0, False)\nleft_drive_smart = MotorGroup(left_motor_a, left_motor_b)\n\nright_motor_a = Motor(Ports.PORT7, 1.0, True)\nright_motor_b = Motor(Ports.PORT9, 1.0, True)\nright_drive_smart = MotorGroup(right_motor_a, right_motor_b)\ndrivetrain = DriveTrain(left_drive_smart, right_drive_smart, 200, 173, 76, MM, 1)\nLeftDiff = Motor(Ports.PORT4, False)\nRightDiff = Motor(Ports.PORT10, False)\ncontroller = Controller()\nPneumatic3 = Pneumatic(Ports.PORT12)\nbumper_2 = Bumper(Ports.PORT2)\ntouchled_8 = Touchled(Ports.PORT8)\ndistance_11 = Distance(Ports.PORT11)\ndistance_5 = Distance(Ports.PORT5)\n\n\n\n# generating and setting random seed\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    xaxis = brain_inertial.acceleration(XAXIS) * 1000\n    yaxis = brain_inertial.acceleration(YAXIS) * 1000\n    zaxis = brain_inertial.acceleration(ZAXIS) * 1000\n    systemTime = brain.timer.system() * 100\n    urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) \n    \n# Initialize random seed \ninitializeRandomSeed()\n\n#endregion VEXcode Generated Robot Configuration\n\nscreen_precision = 0\nconsole_precision = 0\nclaw = 0\nFl4 = 0\nl3l4 = 0\nload = 0\nmy_event = Event()\ni_shall_intake = Event()\ni_shall_launch = Event()\ndl3 = False\n\ndef launch():\n    global claw, Fl4, l3l4, load, my_event, i_shall_intake, i_shall_launch, dl3, screen_precision, console_precision\n    touchled_8.set_color(Color.GREEN)\n    LeftDiff.set_velocity(100, PERCENT)\n    RightDiff.set_velocity(100, PERCENT)\n    LeftDiff.spin_for(FORWARD, 50, DEGREES, wait=False)\n    RightDiff.spin_for(FORWARD, 50, DEGREES)\n    wait(0.1, SECONDS)\n    touchled_8.set_color(Color.RED)\n    load = 1\n    LeftDiff.spin(REVERSE)\n    RightDiff.spin(REVERSE)\n    wait(0.3, SECONDS)\n    while not bumper_2.pressing():\n        wait(20, MSEC)\n    LeftDiff.stop()\n    RightDiff.stop()\n    touchled_8.set_color(Color.GREEN)\n    load = 0\n\ndef claw_intake():\n    global claw, Fl4, l3l4, load, my_event, i_shall_intake, i_shall_launch, dl3, screen_precision, console_precision\n    Pneumatic3.retract(CYLINDER1)\n    if load == 0:\n        LeftDiff.set_velocity(100, PERCENT)\n        RightDiff.set_velocity(100, PERCENT)\n        claw = 1\n        LeftDiff.set_timeout(2, SECONDS)\n        RightDiff.set_timeout(2, SECONDS)\n        RightDiff.spin_for(FORWARD, 200, DEGREES, wait=False)\n        LeftDiff.spin_for(REVERSE, 200, DEGREES)\n        wait(0, SECONDS)\n        Pneumatic3.extend(CYLINDER1)\n        claw = 0\n        LeftDiff.set_timeout(0, SECONDS)\n        RightDiff.set_timeout(0, SECONDS)\n        RightDiff.spin_for(REVERSE, 200, DEGREES, wait=False)\n        LeftDiff.spin_for(FORWARD, 200, DEGREES)\n        LeftDiff.set_velocity(100, PERCENT)\n        RightDiff.set_velocity(100, PERCENT)\n\ndef PID_DRIVE(target_degrees):\n    global claw, Fl4, l3l4, load, my_event, i_shall_intake, i_shall_launch, dl3, screen_precision, console_precision\n    brain_inertial.set_rotation(0, DEGREES)\n    right_drive_smart.spin(REVERSE)\n    left_drive_smart.spin(REVERSE)\n    kp = 1.2\n    kd = 1.2\n    last_error = 0\n    avg_degrees = 0\n    spd = 75\n    error = 0\n    power_diff = 0\n    while(avg_degrees < target_degrees):\n        avg_degrees = (left_drive_smart.position(DEGREES) + right_drive_smart.position(DEGREES)) / 2\n        print(\"error:\" + str(error))\n        print(\"power_diff:\" + str(power_diff))\n        error = brain_inertial.rotation() - 90\n    \n        derivative = error - last_error\n        last_error = error\n        power_diff = error * kp + derivative * kd\n    \n    \n        left_drive_smart.set_velocity(spd - power_diff,PERCENT)\n        right_drive_smart.set_velocity(spd + power_diff,PERCENT)\n        #print(\"avg_degrees:\" + str(avg_degrees) + \"\\n\" + \"spd:\" + str(spd) + \"\\n\" + \"power_diff:\" + str(power_diff) + \"\\n\" + \"der:\" + str(derivative))\n        wait(25,MSEC)\n    drivetrain.stop()\n\ndef when_started1():\n    global claw, Fl4, l3l4, load, my_event, i_shall_intake, i_shall_launch, dl3, screen_precision, console_precision\n    while True:\n        if not dl3 and Fl4 == 1:\n            drivetrain.drive(FORWARD)\n            left_drive_smart.set_velocity((controller.axisA.position()*0.9 + controller.axisC.position() * 0.27), PERCENT)\n            right_drive_smart.set_velocity((controller.axisA.position()*0.9 - controller.axisC.position() * 0.27), PERCENT)\n            wait(0.02, SECONDS)\n        wait(20, MSEC)\n\ndef controllerbuttonRDown_pressed_callback_0():\n    global claw, Fl4, l3l4, load, my_event, i_shall_intake, i_shall_launch, dl3, screen_precision, console_precision\n    i_shall_launch.broadcast()\n\ndef when_started2():\n    global claw, Fl4, l3l4, load, my_event, i_shall_intake, i_shall_launch, dl3, screen_precision, console_precision\n    print(\"\\033[2J\")\n    Fl4 = 0\n    l3l4 = 1\n    LeftDiff.set_max_torque(100, PERCENT)\n    RightDiff.set_max_torque(100, PERCENT)\n    LeftDiff.set_velocity(100, PERCENT)\n    RightDiff.set_velocity(100, PERCENT)\n    load = 1\n    LeftDiff.spin(REVERSE)\n    RightDiff.spin(REVERSE)\n    while not bumper_2.pressing():\n        wait(20, MSEC)\n    LeftDiff.stop()\n    RightDiff.stop()\n    load = 0\n\ndef controllerbuttonRUp_pressed_callback_0():\n    global claw, Fl4, l3l4, load, my_event, i_shall_intake, i_shall_launch, dl3, screen_precision, console_precision\n    if l3l4 == 1:\n        touchled_8.set_color(Color.RED)\n        Pneumatic3.retract(CYLINDER2)\n        l3l4 = 0\n    else:\n        touchled_8.set_color(Color.BLUE)\n        Pneumatic3.extend(CYLINDER2)\n        l3l4 = 1\n\ndef when_started3():\n    global claw, Fl4, l3l4, load, my_event, i_shall_intake, i_shall_launch, dl3, screen_precision, console_precision\n    claw = 1\n    console_precision = 6\n    drivetrain.set_stopping(COAST)\n    left_drive_smart.set_max_torque(100, PERCENT)\n    right_drive_smart.set_max_torque(100, PERCENT)\n\ndef i_shall_intake_callback_0():\n    global claw, Fl4, l3l4, load, my_event, i_shall_intake, i_shall_launch, dl3, screen_precision, console_precision\n    claw_intake()\n\ndef i_shall_launch_callback_0():\n    global claw, Fl4, l3l4, load, my_event, i_shall_intake, i_shall_launch, dl3, screen_precision, console_precision\n    launch()\n\ndef controllerbuttonLDown_pressed_callback_0():\n    global claw, Fl4, l3l4, load, my_event, i_shall_intake, i_shall_launch, dl3, screen_precision, console_precision\n    dl3 = True\n    Pneumatic3.extend(CYLINDER1)\n    drivetrain.set_stopping(COAST)\n    drivetrain.set_drive_velocity(75, PERCENT)\n    PID_DRIVE(800)\n    for repeat_count in range(2):\n        i_shall_intake.broadcast()\n        left_drive_smart.set_position(0,DEGREES)\n        drivetrain.set_drive_velocity(50, PERCENT)\n        drivetrain.drive(REVERSE)\n        wait(0.5, SECONDS)\n        drivetrain.set_drive_velocity(100, PERCENT)\n        drivetrain.drive(REVERSE)\n        # Drive auto from Loading Zone to the shooting area\n        while not (distance_11.object_distance(MM) <= 700 and distance_5.object_distance(MM) <= 700 and (math.fabs(left_drive_smart.position(DEGREES)) > 100)):\n            wait(20, MSEC)\n        i_shall_launch.broadcast()\n        wait(0.3, SECONDS)\n        drivetrain.stop()\n        drivetrain.drive_for(FORWARD, 300, MM)\n        wait(20, MSEC)\n    dl3 = False\n\ndef controllerbuttonLUp_pressed_callback_0():\n    global claw, Fl4, l3l4, load, my_event, i_shall_intake, i_shall_launch, dl3, screen_precision, console_precision\n    Fl4 = 1\n    load = 1\n    LeftDiff.spin(REVERSE)\n    RightDiff.spin(REVERSE)\n    while not bumper_2.pressing():\n        wait(20, MSEC)\n    LeftDiff.stop()\n    RightDiff.stop()\n    load = 0\n\ndef controllerbuttonEUp_pressed_callback_0():\n    global claw, Fl4, l3l4, load, my_event, i_shall_intake, i_shall_launch, dl3, screen_precision, console_precision\n    brain.program_stop()\n\ndef controllerbuttonFDown_pressed_callback_0():\n    global claw, Fl4, l3l4, load, my_event, i_shall_intake, i_shall_launch, dl3, screen_precision, console_precision\n    claw_intake()\n\ndef controllerbuttonEDown_pressed_callback_0():\n    global claw, Fl4, l3l4, load, my_event, i_shall_intake, i_shall_launch, dl3, screen_precision, console_precision\n    if Fl4 == 0:\n        touchled_8.set_color(Color.BLUE)\n        Pneumatic3.extend(CYLINDER2)\n        l3l4 = 1\n        drivetrain.set_drive_velocity(100, PERCENT)\n        drivetrain.set_turn_velocity(50, PERCENT)\n        drivetrain.drive_for(REVERSE, 90, MM)\n        drivetrain.turn_for(LEFT, 18, DEGREES)\n        drivetrain.set_timeout(0.6, SECONDS)\n        drivetrain.drive_for(REVERSE, 100, MM)\n        wait(0.1, SECONDS)\n        my_event.broadcast()\n        Fl4 = 1\n\ndef controllerbuttonFUp_pressed_callback_0():\n    global claw, Fl4, l3l4, load, my_event, i_shall_intake, i_shall_launch, dl3, screen_precision, console_precision\n    if claw == 1:\n        Pneumatic3.extend(CYLINDER1)\n        claw = 0\n    else:\n        Pneumatic3.retract(CYLINDER1)\n        claw = 1\n\n# system event handlers\ncontroller.buttonRDown.pressed(controllerbuttonRDown_pressed_callback_0)\ncontroller.buttonRUp.pressed(controllerbuttonRUp_pressed_callback_0)\ni_shall_intake(i_shall_intake_callback_0)\ni_shall_launch(i_shall_launch_callback_0)\ncontroller.buttonLDown.pressed(controllerbuttonLDown_pressed_callback_0)\ncontroller.buttonLUp.pressed(controllerbuttonLUp_pressed_callback_0)\ncontroller.buttonEUp.pressed(controllerbuttonEUp_pressed_callback_0)\ncontroller.buttonFDown.pressed(controllerbuttonFDown_pressed_callback_0)\ncontroller.buttonEDown.pressed(controllerbuttonEDown_pressed_callback_0)\ncontroller.buttonFUp.pressed(controllerbuttonFUp_pressed_callback_0)\n# add 15ms delay to make sure events are registered correctly.\nwait(15, MSEC)\n\nws2 = Thread( when_started2 )\nws3 = Thread( when_started3 )\nwhen_started1()\n","textLanguage":"python","robotConfig":[{"port":[1,3,7,9,0],"name":"drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"4-motor","wheelSize":"200mm","gearRatio":"1:1","direction":"fwd","gyroType":"none","width":"173","unit":"mm","wheelbase":"76","wheelbaseUnit":"mm","xOffset":"0","yOffset":"0","thetaOffset":"0"},"triportSourcePort":22},{"port":[4],"name":"LeftDiff","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[10],"name":"RightDiff","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[],"name":"controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","e":"","eDir":"false","f":"","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"none"},"triportSourcePort":22},{"port":[12],"name":"Pneumatic3","customName":true,"deviceType":"Pneumatic","deviceClass":"pneumatic","setting":{"cylinder1":"cylinder1","cylinder2":"cylinder2","cylinder1_reversed":"false","cylinder2_reversed":"false"},"triportSourcePort":22},{"port":[2],"name":"bumper_2","customName":false,"deviceType":"Bumper","deviceClass":"bumper","setting":{},"triportSourcePort":22},{"port":[8],"name":"touchled_8","customName":false,"deviceType":"TouchLED","deviceClass":"touchled","setting":{},"triportSourcePort":22},{"port":[11],"name":"distance_11","customName":false,"deviceType":"Distance","deviceClass":"distance","setting":{},"triportSourcePort":22},{"port":[5],"name":"distance_5","customName":false,"deviceType":"Distance","deviceClass":"distance","setting":{},"triportSourcePort":22}],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}