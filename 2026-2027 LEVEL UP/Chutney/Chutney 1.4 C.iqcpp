{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\nmotor LeftDiff = motor(PORT4, false);\nmotor RightDiff = motor(PORT10, false);\ncontroller Controller = controller();\npneumatic Pneumatic3 = pneumatic(PORT12);\nbumper Ramp = bumper(PORT5);\ntouchled TouchLED8 = touchled(PORT8);\ndistance Distance11 = distance(PORT11);\nbumper catapult = bumper(PORT2);\nmotor RMotorA = motor(PORT1, false);\nmotor RMotorB = motor(PORT3, false);\nmotor_group R = motor_group(RMotorA, RMotorB);\n\nmotor LMotorA = motor(PORT7, true);\nmotor LMotorB = motor(PORT9, true);\nmotor_group L = motor_group(LMotorA, LMotorB);\n\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n\n// define variable for remote controller enable/disable\nbool RemoteControlCodeEnabled = true;\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n// Include the IQ Library\n#include \"vex.h\"\n  \n// Allows for easier use of the VEX Library\nusing namespace vex;\n\n// User defined function\nvoid myblockfunction_turn_turn_stop(double myblockfunction_turn_turn_stop__turn, double myblockfunction_turn_turn_stop__stop);\n// User defined function\nvoid myblockfunction_turn_target_target_compensation_c_velocity_v_stop_stop(double myblockfunction_turn_target_target_compensation_c_velocity_v_stop_stop__target, double myblockfunction_turn_target_target_compensation_c_velocity_v_stop_stop__c, double myblockfunction_turn_target_target_compensation_c_velocity_v_stop_stop__v, double myblockfunction_turn_target_target_compensation_c_velocity_v_stop_stop__stop);\n// User defined function\nvoid myblockfunction_launch();\n// User defined function\nvoid myblockfunction_stop_diff();\n// User defined function\nvoid myblockfunction_claw_intake();\n// User defined function\nvoid myblockfunction_init();\n// User defined function\nvoid myblockfunction_wind_up();\n// User defined function\nvoid myblockfunction_on_field_beanbags();\n// User defined function\nvoid myblockfunction_stop_LR();\n// User defined function\nvoid myblockfunction_move__L_L_R_R_Time_T_stop_stop(double myblockfunction_move__L_L_R_R_Time_T_stop_stop__L, double myblockfunction_move__L_L_R_R_Time_T_stop_stop__R, double myblockfunction_move__L_L_R_R_Time_T_stop_stop__T, double myblockfunction_move__L_L_R_R_Time_T_stop_stop__stop);\n// User defined function\nvoid myblockfunction_move__R_R_L_L_distance_d_stop_stop(double myblockfunction_move__R_R_L_L_distance_d_stop_stop__R, double myblockfunction_move__R_R_L_L_distance_d_stop_stop__L, double myblockfunction_move__R_R_L_L_distance_d_stop_stop__d, double myblockfunction_move__R_R_L_L_distance_d_stop_stop__stop);\n\nint Screen_precision = 0, Console_precision = 0;\n\nfloat claw, Fl4, l3l4, load, intake_angle, dead_band, controller_x, controller_y, direction, target_angle, turn_speed;\n\nbool dl3, intake;\n\nevent i_shall_intake = event();\nevent i_shall_launch = event();\n\n// User defined function\nvoid myblockfunction_turn_turn_stop(double myblockfunction_turn_turn_stop__turn, double myblockfunction_turn_turn_stop__stop) {\n  myblockfunction_turn_target_target_compensation_c_velocity_v_stop_stop(myblockfunction_turn_turn_stop__turn, -9.0, 100.0, myblockfunction_turn_turn_stop__stop);\n}\n\n// User defined function\nvoid myblockfunction_turn_target_target_compensation_c_velocity_v_stop_stop(double myblockfunction_turn_target_target_compensation_c_velocity_v_stop_stop__target, double myblockfunction_turn_target_target_compensation_c_velocity_v_stop_stop__c, double myblockfunction_turn_target_target_compensation_c_velocity_v_stop_stop__v, double myblockfunction_turn_target_target_compensation_c_velocity_v_stop_stop__stop) {\n  direction = myblockfunction_turn_target_target_compensation_c_velocity_v_stop_stop__target - BrainInertial.rotation();\n  direction = direction / fabs(static_cast<float>(direction));\n  target_angle = myblockfunction_turn_target_target_compensation_c_velocity_v_stop_stop__target + direction * myblockfunction_turn_target_target_compensation_c_velocity_v_stop_stop__c;\n  while (!((target_angle - BrainInertial.rotation()) * direction <= 0.0)) {\n    turn_speed = 0.4 * fabs(static_cast<float>(target_angle - BrainInertial.rotation()));\n    if (turn_speed > myblockfunction_turn_target_target_compensation_c_velocity_v_stop_stop__v) {\n      turn_speed = myblockfunction_turn_target_target_compensation_c_velocity_v_stop_stop__v;\n    }\n    if (turn_speed < 10.0) {\n      turn_speed = 10.0;\n    }\n    L.setVelocity((-1.0 * (direction * turn_speed)), percent);\n    R.setVelocity((direction * turn_speed), percent);\n    L.spin(forward);\n    R.spin(forward);\n  wait(20, msec);\n  }\n  if (myblockfunction_turn_target_target_compensation_c_velocity_v_stop_stop__stop > 0.0) {\n    L.stop();\n    R.stop();\n    wait(myblockfunction_turn_target_target_compensation_c_velocity_v_stop_stop__stop, seconds);\n  }\n}\n\n// User defined function\nvoid myblockfunction_launch() {\n  TouchLED8.setColor(green);\n  LeftDiff.setVelocity(100.0, percent);\n  RightDiff.setVelocity(100.0, percent);\n  LeftDiff.spin(forward);\n  RightDiff.spin(forward);\n  wait(0.3, seconds);\n  myblockfunction_stop_diff();\n  myblockfunction_wind_up();\n  TouchLED8.setColor(red);\n}\n\n// User defined function\nvoid myblockfunction_stop_diff() {\n  LeftDiff.stop();\n  RightDiff.stop();\n}\n\n// User defined function\nvoid myblockfunction_claw_intake() {\n  Pneumatic3.retract(cylinder1);\n  if (load == 0.0) {\n    intake = true;\n    LeftDiff.setVelocity(100.0, percent);\n    RightDiff.setVelocity(100.0, percent);\n    claw = 1.0;\n    LeftDiff.setStopping(coast);\n    RightDiff.setStopping(coast);\n    LeftDiff.setTimeout(2.5, seconds);\n    RightDiff.setTimeout(2.5, seconds);\n    RightDiff.spinFor(forward, intake_angle, degrees, false);\n    LeftDiff.spinFor(reverse, intake_angle, degrees, true);\n    wait(0.05, seconds);\n    Pneumatic3.extend(cylinder1);\n    wait(0.05, seconds);\n    claw = 0.0;\n    LeftDiff.setTimeout(0.0, seconds);\n    RightDiff.setTimeout(0.0, seconds);\n    RightDiff.spinFor(reverse, intake_angle, degrees, false);\n    LeftDiff.spinFor(forward, intake_angle, degrees, true);\n    LeftDiff.setVelocity(100.0, percent);\n    RightDiff.setVelocity(100.0, percent);\n    intake = false;\n  }\n}\n\n// User defined function\nvoid myblockfunction_init() {\n  claw = 1.0;\n  intake_angle = 200.0;\n  Console_precision = 6;\n  R.setStopping(coast);\n  L.setStopping(coast);\n  printf(\"\\033[2J\\n\");\n  Fl4 = 0.0;\n  l3l4 = 0.0;\n  LeftDiff.setMaxTorque(100.0, percent);\n  RightDiff.setMaxTorque(100.0, percent);\n  LeftDiff.setVelocity(100.0, percent);\n  RightDiff.setVelocity(100.0, percent);\n  load = 1.0;\n  myblockfunction_wind_up();\n  load = 0.0;\n}\n\n// User defined function\nvoid myblockfunction_wind_up() {\n  load = 1.0;\n  LeftDiff.spin(reverse);\n  RightDiff.spin(reverse);\n  wait(0.3, seconds);\n  waitUntil((catapult.pressing() || fabs(static_cast<float>(RightDiff.velocity(percent))) < 5.0));\n  LeftDiff.stop();\n  RightDiff.stop();\n  load = 0.0;\n}\n\n// User defined function\nvoid myblockfunction_on_field_beanbags() {\n}\n\n// User defined function\nvoid myblockfunction_stop_LR() {\n  R.stop();\n  L.stop();\n}\n\n// User defined function\nvoid myblockfunction_move__L_L_R_R_Time_T_stop_stop(double myblockfunction_move__L_L_R_R_Time_T_stop_stop__L, double myblockfunction_move__L_L_R_R_Time_T_stop_stop__R, double myblockfunction_move__L_L_R_R_Time_T_stop_stop__T, double myblockfunction_move__L_L_R_R_Time_T_stop_stop__stop) {\n  L.setVelocity(myblockfunction_move__L_L_R_R_Time_T_stop_stop__R, percent);\n  R.setVelocity(myblockfunction_move__L_L_R_R_Time_T_stop_stop__L, percent);\n  R.spin(forward);\n  L.spin(forward);\n  wait(myblockfunction_move__L_L_R_R_Time_T_stop_stop__T, seconds);\n  if (myblockfunction_move__L_L_R_R_Time_T_stop_stop__stop > 0.0) {\n    L.stop();\n    R.stop();\n    wait(myblockfunction_move__L_L_R_R_Time_T_stop_stop__stop, seconds);\n  }\n}\n\n// User defined function\nvoid myblockfunction_move__R_R_L_L_distance_d_stop_stop(double myblockfunction_move__R_R_L_L_distance_d_stop_stop__R, double myblockfunction_move__R_R_L_L_distance_d_stop_stop__L, double myblockfunction_move__R_R_L_L_distance_d_stop_stop__d, double myblockfunction_move__R_R_L_L_distance_d_stop_stop__stop) {\n  R.setPosition(0.0, degrees);\n  L.setPosition(0.0, degrees);\n  L.setVelocity(myblockfunction_move__R_R_L_L_distance_d_stop_stop__R, percent);\n  R.setVelocity(myblockfunction_move__R_R_L_L_distance_d_stop_stop__L, percent);\n  R.spin(forward);\n  L.spin(forward);\n  waitUntil(((fabs(static_cast<float>(L.position(degrees))) + fabs(static_cast<float>(R.position(degrees)))) / 2.0 >= myblockfunction_move__R_R_L_L_distance_d_stop_stop__d));\n  if (myblockfunction_move__R_R_L_L_distance_d_stop_stop__stop > 0.0) {\n    L.stop();\n    R.stop();\n    wait(myblockfunction_move__R_R_L_L_distance_d_stop_stop__stop, seconds);\n  }\n}\n\n// \"when started\" hat block\nint whenStarted1() {\n  while (true) {\n    if (!dl3 && Fl4 == 1.0) {\n      R.spin(forward);\n      L.spin(forward);\n      controller_y = Controller.AxisA.position();\n      controller_x = 0.0 - Controller.AxisC.position();\n      L.setVelocity((controller_y * 0.9 + controller_x * 0.27), percent);\n      R.setVelocity((controller_y * 0.9 - controller_x * 0.27), percent);\n      wait(0.02, seconds);\n    }\n  wait(20, msec);\n  }\n  return 0;\n}\n\n// \"when Controller ButtonRDown pressed\" hat block\nvoid onevent_ControllerButtonRDown_pressed_0() {\n  i_shall_launch.broadcast();\n}\n\n// \"when Controller ButtonRUp pressed\" hat block\nvoid onevent_ControllerButtonRUp_pressed_0() {\n  if (l3l4 == 1.0) {\n    TouchLED8.setColor(red);\n    Pneumatic3.retract(cylinder2);\n    l3l4 = 0.0;\n  }\n  else {\n    TouchLED8.setColor(blue);\n    Pneumatic3.extend(cylinder2);\n    l3l4 = 1.0;\n  }\n}\n\n// \"when started\" hat block\nint whenStarted2() {\n  myblockfunction_init();\n  return 0;\n}\n\n// \"when I receive i_shall_intake\" hat block\nvoid onevent_i_shall_intake_0() {\n  myblockfunction_claw_intake();\n}\n\n// \"when I receive i_shall_launch\" hat block\nvoid onevent_i_shall_launch_0() {\n  myblockfunction_launch();\n}\n\n// \"when Controller ButtonLDown pressed\" hat block\nvoid onevent_ControllerButtonLDown_pressed_0() {\n  dl3 = true;\n  myblockfunction_on_field_beanbags();\n  repeat(8) {\n    Pneumatic3.extend(cylinder1);\n    myblockfunction_move__R_R_L_L_distance_d_stop_stop(100.0, 100.0, 100.0, 0.05);\n    R.setStopping(coast);\n    L.setStopping(coast);\n    myblockfunction_move__L_L_R_R_Time_T_stop_stop(50.0, 100.0, 0.5, 0.0);\n    myblockfunction_move__L_L_R_R_Time_T_stop_stop(90.0, 100.0, 1.0, 0.0);\n    // repeat blah blah i know\n    waitUntil((load == 0.0));\n    Pneumatic3.retract(cylinder1);\n    i_shall_intake.broadcast();\n    // the little drivety thing that we reworked\n    myblockfunction_move__R_R_L_L_distance_d_stop_stop(-100.0, -50.0, 100.0, 0.0);\n    myblockfunction_move__L_L_R_R_Time_T_stop_stop(-50.0, -100.0, 0.5, 0.0);\n    myblockfunction_move__L_L_R_R_Time_T_stop_stop(-100.0, -100.0, 1.0, 0.0);\n    // Drive auto from Loading Zone to the shooting area\n    waitUntil(Ramp.pressing());\n    TouchLED8.setColor(blue);\n    i_shall_launch.broadcast();\n    wait(0.5, seconds);\n    myblockfunction_stop_LR();\n    wait(20, msec);\n  }\n  dl3 = false;\n}\n\n// Used to find the format string for printing numbers with the\n// desired number of decimal places\nconst char* printToConsole_numberFormat() {\n  // look at the current precision setting to find the format string\n  switch(Console_precision){\n    case 0:  return \"%.0f\"; // 0 decimal places (1)\n    case 1:  return \"%.1f\"; // 1 decimal place  (0.1)\n    case 2:  return \"%.2f\"; // 2 decimal places (0.01)\n    case 3:  return \"%.3f\"; // 3 decimal places (0.001)\n    default: return \"%f\"; // use the print system default for everthing else\n  }\n}\n\n// \"when started\" hat block\nint whenStarted3() {\n  while (true) {\n    printf(printToConsole_numberFormat(), static_cast<float>(RightDiff.velocity(percent)));\n    printf(\"\\n\");\n  wait(20, msec);\n  }\n  return 0;\n}\n\n// \"when Controller ButtonLUp pressed\" hat block\nvoid onevent_ControllerButtonLUp_pressed_0() {\n  Fl4 = 1.0;\n  load = 1.0;\n  myblockfunction_wind_up();\n  load = 0.0;\n}\n\n// \"when Controller ButtonEUp pressed\" hat block\nvoid onevent_ControllerButtonEUp_pressed_0() {\n  Brain.programStop();\n}\n\n// \"when Controller ButtonFDown pressed\" hat block\nvoid onevent_ControllerButtonFDown_pressed_0() {\n  myblockfunction_claw_intake();\n}\n\n// \"when Controller ButtonEDown pressed\" hat block\nvoid onevent_ControllerButtonEDown_pressed_0() {\n  if (Fl4 == 0.0) {\n    TouchLED8.setColor(blue);\n    Pneumatic3.extend(cylinder2);\n    l3l4 = 1.0;\n    myblockfunction_move__R_R_L_L_distance_d_stop_stop(-28.0, -100.0, 130.0, 0.0);\n    myblockfunction_move__L_L_R_R_Time_T_stop_stop(-50.0, -50.0, 0.5, 0.1);\n    wait(0.1, seconds);\n    i_shall_launch.broadcast();\n    Fl4 = 1.0;\n  }\n}\n\n// \"when Controller ButtonFUp pressed\" hat block\nvoid onevent_ControllerButtonFUp_pressed_0() {\n  if (claw == 1.0) {\n    Pneumatic3.extend(cylinder1);\n    claw = 0.0;\n  }\n  else {\n    Pneumatic3.retract(cylinder1);\n    claw = 1.0;\n  }\n}\n\n\nint main() {\n  // Initializing Robot Configuration. DO NOT REMOVE!\n  vexcodeInit();\n\n  // register event handlers\n  Controller.ButtonRDown.pressed(onevent_ControllerButtonRDown_pressed_0);\n  Controller.ButtonRUp.pressed(onevent_ControllerButtonRUp_pressed_0);\n  i_shall_intake(onevent_i_shall_intake_0);\n  i_shall_launch(onevent_i_shall_launch_0);\n  Controller.ButtonLDown.pressed(onevent_ControllerButtonLDown_pressed_0);\n  Controller.ButtonLUp.pressed(onevent_ControllerButtonLUp_pressed_0);\n  Controller.ButtonEUp.pressed(onevent_ControllerButtonEUp_pressed_0);\n  Controller.ButtonFDown.pressed(onevent_ControllerButtonFDown_pressed_0);\n  Controller.ButtonEDown.pressed(onevent_ControllerButtonEDown_pressed_0);\n  Controller.ButtonFUp.pressed(onevent_ControllerButtonFUp_pressed_0);\n\n  wait(15, msec);\n  vex::task ws1(whenStarted2);\n  vex::task ws2(whenStarted3);\n  whenStarted1();\n}","textLanguage":"cpp","robotConfig":[{"port":[4],"name":"LeftDiff","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[10],"name":"RightDiff","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[],"name":"Controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","e":"","eDir":"false","f":"","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"none"},"triportSourcePort":22},{"port":[12],"name":"Pneumatic3","customName":true,"deviceType":"Pneumatic","deviceClass":"pneumatic","setting":{"cylinder1":"cylinder1","cylinder2":"cylinder2","cylinder1_reversed":"false","cylinder2_reversed":"false"},"triportSourcePort":22},{"port":[5],"name":"Ramp","customName":true,"deviceType":"Bumper","deviceClass":"bumper","setting":{},"triportSourcePort":22},{"port":[8],"name":"TouchLED8","customName":false,"deviceType":"TouchLED","deviceClass":"touchled","setting":{},"triportSourcePort":22},{"port":[11],"name":"Distance11","customName":false,"deviceType":"Distance","deviceClass":"distance","setting":{},"triportSourcePort":22},{"port":[2],"name":"catapult","customName":true,"deviceType":"Bumper","deviceClass":"bumper","setting":{},"triportSourcePort":22},{"port":[1,3],"name":"R","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","motor_a_reversed":"false","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[7,9],"name":"L","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","motor_a_reversed":"true","motor_b_reversed":"true"},"triportSourcePort":22}],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}